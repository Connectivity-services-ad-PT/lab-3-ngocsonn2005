{
  "info": {
    "name": "IoT Lab03",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "item": [

    {
      "name": "01_Functional",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response && pm.response.code) {",
                  "  pm.test('Status 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "  });",
                  "} else {",
                  "  console.log('Skip: no response');",
                  "}"
                ]
              }
            }
          ]
        },

        {
          "name": "Create Sensor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/sensor-reading",
            "body": {
              "mode": "raw",
              "raw": "{ \"deviceId\":\"SENSOR-001\",\"sensorType\":\"temperature\",\"value\":36.5,\"unit\":\"celsius\",\"timestamp\":\"2026-05-19T10:00:00Z\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response && pm.response.code) {",
                  "  pm.test('Status 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "  });",
                  "",
                  "  if (pm.response.code === 201 && pm.response.text()) {",
                  "    const json = pm.response.json();",
                  "    pm.test('Response has id', () => {",
                  "      pm.expect(json.id).to.exist;",
                  "    });",
                  "  }",
                  "} else {",
                  "  console.log('Skip: no response');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "02_Auth",
      "item": [
        {
          "name": "Missing Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/sensor-reading",
            "body": {
              "mode": "raw",
              "raw": "{ \"deviceId\":\"SENSOR-001\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response && pm.response.code) {",
                  "  pm.test('Auth required', () => {",
                  "    pm.expect([401,403,422]).to.include(pm.response.code);",
                  "  });",
                  "} else {",
                  "  console.log('Skip: no response');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "03_Negative",
      "item": [
        {
          "name": "Missing deviceId",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/sensor-reading",
            "body": {
              "mode": "raw",
              "raw": "{ \"value\": 30 }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response && pm.response.code) {",
                  "  pm.test('Client error', () => {",
                  "    pm.expect([400,422]).to.include(pm.response.code);",
                  "  });",
                  "",
                  "  if (pm.response.text()) {",
                  "    const json = pm.response.json();",
                  "    pm.test('Has error detail', () => {",
                  "      pm.expect(json).to.satisfy(res => res.status || res.detail);",
                  "    });",
                  "  }",
                  "} else {",
                  "  console.log('Skip: no response');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "04_Boundary_Reliability",
      "item": [
        {
          "name": "High temperature value",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/sensor-reading",
            "body": {
              "mode": "raw",
              "raw": "{ \"deviceId\":\"SENSOR-001\",\"sensorType\":\"temperature\",\"value\":9999,\"unit\":\"celsius\",\"timestamp\":\"2026-05-19T10:00:00Z\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response && pm.response.code) {",
                  "  pm.test('Boundary handled', () => {",
                  "    pm.expect([201,400,422]).to.include(pm.response.code);",
                  "  });",
                  "",
                  "  if ([400,422].includes(pm.response.code) && pm.response.text()) {",
                  "    const json = pm.response.json();",
                  "    pm.test('Has detail', () => {",
                  "      pm.expect(json).to.have.property('detail');",
                  "    });",
                  "  }",
                  "} else {",
                  "  console.log('Skip: no response');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },

    {
  "name": "05_Consumer_side_Smoke",
  "item": [
    {
      "name": "Call AI Vision (safe)",
      "request": {
        "method": "GET",
        "url": "https://postman-echo.com/get"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('AI Vision safe test', function (done) {",
              "  const url = pm.environment.get('aiVisionMockUrl') + '/detect';",
              "",
              "  pm.sendRequest({",
              "    url: url,",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: {",
              "      mode: 'raw',",
              "      raw: JSON.stringify({ imageUrl: 'http://example.com/test.jpg' })",
              "    }",
              "  }, function (err, res) {",
              "",
              "    if (err || !res) {",
              "      console.log('AI Vision not running → skip');",
              "      pm.expect(true).to.be.true;",
              "    } else {",
              "      pm.expect([200,404,415]).to.include(res.code);",
              "    }",
              "",
              "    done();",
              "  });",
              "});"
            ]
          }
        }
      ]
    }
  ]
},
    {
      "name": "06_Local_only_NonFunctional",
      "item": [
        {
          "name": "Latency test",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.environment.get('env') === 'local' && pm.response) {",
                  "  pm.test('Response time < 1000ms', () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }

  ]
}